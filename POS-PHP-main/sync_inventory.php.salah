<?php

$active = 'products';
require_once __DIR__ . "/config/database.php";
require_once __DIR__ . "/includes/helpers.php";

$errors = [];
$product = [
    'id' => '',
    'category_id' => '',
    'name' => '',
    'sku' => '',
    'description' => '',
    'price' => '',
    'stock' => '',
    'minimum_stock' => 5,
];

$isEdit = isset($_GET['id']);

if ($isEdit) {
    $stmt = $pdo->prepare("SELECT * FROM products WHERE id = ?");
    $stmt->execute([$_GET['id']]);
    $found = $stmt->fetch();

    if (!$found) {
        set_flash('error', 'Product not found.');
        header('Location: products.php');
        exit;
    }

    $product = $found;
}

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    if (!verify_csrf()) {
        set_flash('error', 'Invalid form submission. Please try again.');
        header('Location: products.php');
        exit;
    }

    $product['id'] = $_POST['id'] ?? '';
    $product['category_id'] = $_POST['category_id'] ?? '';
    $product['name'] = trim($_POST['name'] ?? '');
    $product['sku'] = trim($_POST['sku'] ?? '');
    $product['description'] = trim($_POST['description'] ?? '');
    $product['price'] = $_POST['price'] ?? '';
    $product['stock'] = $_POST['stock'] ?? '';
    $product['minimum_stock'] = $_POST['minimum_stock'] ?? 5;

    if ($product['name'] === '') {
        $errors[] = 'Product name is required.';
    }

    if ($product['sku'] === '') {
        $errors[] = 'SKU is required.';
    }

    if ($product['category_id'] === '') {
        $errors[] = 'Please select a category.';
    }

    if (!is_numeric($product['price']) || $product['price'] < 0) {
        $errors[] = 'Price must be a valid positive number.';
    }

    if (!ctype_digit((string) $product['stock'])) {
        $errors[] = 'Stock must be a whole number.';
    }

    if (!ctype_digit((string) $product['minimum_stock'])) {
        $errors[] = 'Minimum stock must be a whole number.';
    }

    if (empty($errors)) {
        try {
            if ($product['id'] !== '') {
                $stmt = $pdo->prepare("
                    UPDATE products
                    SET category_id = :category_id,
                        name = :name,
                        sku = :sku,
                        description = :description,
                        price = :price,
                        stock = :stock,
                        minimum_stock = :minimum_stock
                    WHERE id = :id
                ");

                $stmt->execute([
                    'category_id' => $product['category_id'],
                    'name' => $product['name'],
                    'sku' => $product['sku'],
                    'description' => $product['description'],
                    'price' => $product['price'],
                    'stock' => $product['stock'],
                    'minimum_stock' => $product['minimum_stock'],
                    'id' => $product['id'],
                ]);

                set_flash('success', 'Product updated successfully.');
            } else {
                $stmt = $pdo->prepare("
                    INSERT INTO products (
                        category_id,
                        name,
                        sku,
                        description,
                        price,
                        stock,
                        minimum_stock
                    )
                    VALUES (
                        :category_id,
                        :name,
                        :sku,
                        :description,
                        :price,
                        :stock,
                        :minimum_stock
                    )
                ");

                $stmt->execute([
                    'category_id' => $product['category_id'],
                    'name' => $product['name'],
                    'sku' => $product['sku'],
                    'description' => $product['description'],
                    'price' => $product['price'],
                    'stock' => $product['stock'],
                    'minimum_stock' => $product['minimum_stock'],
                ]);

                set_flash('success', 'Product created successfully.');
            }

            /*
             * Sinkronisasi Inventory ke POS.
             * Jika gagal, produk tetap tersimpan di Inventory.
             */
            $syncToken = getenv('SYNC_TOKEN') ?: '';

            if ($syncToken !== '') {
                $syncContext = stream_context_create([
                    'http' => [
                        'method' => 'POST',
                        'header' => "X-Sync-Token: " . $syncToken . "\r\n",
                        'content' => '',
                        'timeout' => 5,
                        'ignore_errors' => true,
                    ],
                ]);

                @file_get_contents(
                    'http://pos/sync_inventory.php',
                    false,
                    $syncContext
                );
            }

            header('Location: products.php');
            exit;

        } catch (PDOException $e) {
            if ($e->getCode() == 23000) {
                $errors[] = 'That SKU is already in use by another product.';
            } else {
                $errors[] = 'Something went wrong while saving the product.';
            }
        }
    }
}

$categories = $pdo->query(
    "SELECT * FROM categories ORDER BY name ASC"
)->fetchAll();

require_once __DIR__ . "/includes/header.php";

?>

<section class="page-header">
    <div>
        <p class="eyebrow">PRODUCTS</p>
        <h1><?php echo $isEdit ? 'Edit Product' : 'Add Product'; ?></h1>
        <p class="subtitle">Fill in the details below.</p>
    </div>

    <a href="products.php" class="secondary-button">
        &larr; Back to Products
    </a>
</section>

<section class="content-card">
    <?php if (!empty($errors)): ?>
        <div class="alert alert-error">
            <ul>
                <?php foreach ($errors as $error): ?>
                    <li><?php echo htmlspecialchars($error); ?></li>
                <?php endforeach; ?>
            </ul>
        </div>
    <?php endif; ?>

    <form method="POST" class="form-grid">
        <?php echo csrf_field(); ?>

        <input
            type="hidden"
            name="id"
            value="<?php echo htmlspecialchars((string) $product['id']); ?>"
        >

        <div class="form-group">
            <label for="name">Product Name</label>
            <input
                type="text"
                id="name"
                name="name"
                value="<?php echo htmlspecialchars($product['name']); ?>"
                required
            >
        </div>

        <div class="form-group">
            <label for="sku">SKU</label>
            <input
                type="text"
                id="sku"
                name="sku"
                value="<?php echo htmlspecialchars($product['sku']); ?>"
                required
            >
        </div>

        <div class="form-group">
            <label for="category_id">Category</label>
            <select id="category_id" name="category_id" required>
                <option value="">Select category</option>

                <?php foreach ($categories as $category): ?>
                    <option
                        value="<?php echo $category['id']; ?>"
                        <?php echo $product['category_id'] == $category['id'] ? 'selected' : ''; ?>
                    >
                        <?php echo htmlspecialchars($category['name']); ?>
                    </option>
                <?php endforeach; ?>
            </select>
        </div>

        <div class="form-group">
            <label for="price">Price</label>
            <input
                type="number"
                step="0.01"
                min="0"
                id="price"
                name="price"
                value="<?php echo htmlspecialchars((string) $product['price']); ?>"
                required
            >
        </div>

        <div class="form-group">
            <label for="stock">Stock</label>
            <input
                type="number"
                min="0"
                id="stock"
                name="stock"
                value="<?php echo htmlspecialchars((string) $product['stock']); ?>"
                required
            >
        </div>

        <div class="form-group">
            <label for="minimum_stock">Minimum Stock</label>
            <input
                type="number"
                min="0"
                id="minimum_stock"
                name="minimum_stock"
                value="<?php echo htmlspecialchars((string) $product['minimum_stock']); ?>"
                required
            >
        </div>

        <div class="form-group form-group-full">
            <label for="description">Description</label>
            <textarea
                id="description"
                name="description"
                rows="3"
            ><?php echo htmlspecialchars($product['description']); ?></textarea>
        </div>

        <div class="form-actions">
            <button type="submit" class="primary-button">
                <?php echo $isEdit ? 'Update Product' : 'Save Product'; ?>
            </button>

            <a href="products.php" class="secondary-button">Cancel</a>
        </div>
    </form>
</section>

<?php require_once __DIR__ . "/includes/footer.php"; ?>
